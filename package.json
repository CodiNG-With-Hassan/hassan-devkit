{
  "name": "hassan-devkit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared developer-experience toolkit: ESLint/Prettier/lint-staged configs, a small CLI, and a Renovate preset, used across Hassan's client projects.",
  "license": "MIT",
  "author": "Hassan Khousheish",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodiNG-With-Hassan/hassan-devkit.git"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "echo 'no build step \u2014 packages ship plain JS/JSON'",
    "lint": "echo 'no shared lint step yet'",
    "test": "pnpm --filter @coding-with-hassan/devkit test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@coding-with-hassan/devkit": "workspace:*",
    "mattpocock-skills": "github:mattpocock/skills#v1.2.3"
  },
  "engines": {
    "node": ">=20"
  },
  "hassan-devkit": {
    "worktree": {
      "ports": {},
      "profiles": {
        "default": [],
        "required": []
      },
      "seeds": {
        "scripts": []
      },
      "env": {}
    },
    "tracker": {
      "kind": "github",
      "prefix": "GH"
    },
    "commits": {},
    "ci": {
      "checks": []
    }
  }
}
