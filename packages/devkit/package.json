{
  "name": "@coding-with-hassan/devkit",
  "version": "1.0.0-next.0",
  "description": "CLI for the developer workflow shared across Hassan's client projects: docker compose orchestration, db helpers, and husky hook installation.",
  "license": "MIT",
  "author": "Hassan Khousheish",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodiNG-With-Hassan/hassan-devkit.git",
    "directory": "packages/devkit"
  },
  "keywords": [
    "cli",
    "docker",
    "husky",
    "lint-staged",
    "monorepo"
  ],
  "type": "module",
  "bin": {
    "hassan-devkit": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "claude",
    "lint-staged.js",
    "test-cases.js",
    "test-cases.d.ts",
    "README.md"
  ],
  "dependencies": {
    "cac": "^6.7.14",
    "exceljs": "^4.4.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./lint-staged": "./lint-staged.js",
    "./test-cases": {
      "types": "./test-cases.d.ts",
      "default": "./test-cases.js"
    },
    "./package.json": "./package.json"
  }
}
